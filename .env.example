# Copy to .env and adjust. Loaded by `npm run dev:api`, `npm run db:setup` and `npm start`.

API_PORT=3001
DB_NAME=VehicleInventory

# --- Option A: local SQL Server Express on Windows, Windows authentication ---
# Uses the ODBC driver, so TCP/IP does not need to be enabled on the instance.
DB_DRIVER=msnodesqlv8
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# --- Option B: SQL login over TCP (Docker, Linux/macOS, Azure SQL) ---
# DB_DRIVER=tedious
# DB_SERVER=localhost
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=true

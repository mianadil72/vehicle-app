# Copy to .env and adjust. Loaded by `npm run dev:api`, `npm run db:setup` and `npm start`.

API_PORT=3001
DB_NAME=VehicleInventory

# --- Option A: local SQL Server Express on Windows, Windows authentication ---
# Uses the ODBC driver, so TCP/IP does not need to be enabled on the instance.
DB_DRIVER=msnodesqlv8
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# --- Option B: SQL login over TCP (Docker, Linux/macOS, Azure SQL) ---
# DB_DRIVER=tedious
# DB_SERVER=localhost
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=true

# --- Customer chat (Microsoft Foundry agent) ---
# Leave PROJECT_ENDPOINT unset to hide the chat. Auth uses DefaultAzureCredential (`az login` locally).
# PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# MODEL_DEPLOYMENT_NAME=gpt-4.1-mini   (only used by `npm run agent:setup`)
# FOUNDRY_AGENT_NAME=vehicle-new-agent-gpt-mini

# --- Accounting ---
# Time zone for "today" (default sale date, pay periods, weekly stats). IANA name.
# DEALER_TIME_ZONE=America/Los_Angeles

# --- CRM: new-lead notifications to the lead sales manager ---
# Email and/or text (an email-to-SMS gateway address from the carrier, e.g. 5551234567@vtext.com,
# 5551234567@txt.att.net, 5551234567@tmomail.net). Leave both unset to notify nobody.
# LEAD_MANAGER_EMAIL=sales-manager@example.com
# LEAD_MANAGER_SMS=5551234567@vtext.com
# Base URL used for links in those messages (the Vite dev server by default).
# APP_BASE_URL=http://localhost:5173
# SMTP server. Without SMTP_HOST, messages are only printed to the API console (status "Logged").
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false        (true for port 465)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=One-Stop Vehicle Shop <no-reply@example.com>
